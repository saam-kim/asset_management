rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /sessions/{sessionId} {
      allow create: if signedIn()
        && request.resource.data.teacherUid == request.auth.uid
        && request.resource.data.status == 'active';
      allow get: if signedIn();
      allow list: if false;
      allow update, delete: if signedIn()
        && resource.data.teacherUid == request.auth.uid;

      match /students/{studentId} {
        allow create: if signedIn()
          && studentId == request.auth.uid
          && get(/databases/$(database)/documents/sessions/$(sessionId)).data.status == 'active';
        allow get, update: if signedIn() && (
          studentId == request.auth.uid
          || get(/databases/$(database)/documents/sessions/$(sessionId)).data.teacherUid == request.auth.uid
        );
        allow list: if signedIn()
          && get(/databases/$(database)/documents/sessions/$(sessionId)).data.teacherUid == request.auth.uid;
        allow delete: if false;
      }
    }
  }
}
